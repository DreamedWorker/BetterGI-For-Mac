<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BetterGI.Mac</RootNamespace>
    <AssemblyName>BetterGI</AssemblyName>
    <Version>0.1.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1701;NU1903;NU1902</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- Upstream's asset packages: their content files (Assets/...) are copied to the output folder. -->
    <PackageReference Include="BetterGI.Assets.Map" Version="1.0.26" />
    <PackageReference Include="BetterGI.Assets.Model" Version="1.0.41" />
    <PackageReference Include="BetterGI.Assets.Other" Version="1.0.31" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="7.4.5" />
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.4.5" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- App icon: AppIcon.png is the source, AppIcon.icns (built from it with sips + iconutil) goes into the bundle. -->
    <AvaloniaResource Include="Assets/AppIcon.png" />
    <Content Include="Assets/config-docs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BetterGI.Mac.Platform/BetterGI.Mac.Platform.csproj" />
    <ProjectReference Include="../BetterGI.Core/BetterGI.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Upstream's task resources (templates, Recognition.json, data), copied at upstream's relative paths. -->
    <Content Include="$(UpstreamRoot)BetterGenshinImpact/GameTask/**/*" Exclude="$(UpstreamRoot)BetterGenshinImpact/GameTask/**/*.cs"
             Link="GameTask/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Exclude.props" />
  <!-- Upstream's non-UI code compiled unchanged for plain net10.0. Files that are Windows-only by nature are listed in
       Exclude.props; WPF / WinForms types the remaining code mentions are provided by Shims/. Work in progress. -->
  <PropertyGroup>
    <RootNamespace>BetterGenshinImpact</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CS8632;NU1701;NU1903;NU1902;CS0618</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(U)**/*.cs" Exclude="$(U)View/**;$(U)ViewModel/**;$(U)Markup/**;$(U)obj/**;$(U)bin/**;$(U)App.xaml.cs;$(U)AssemblyInfo.cs;$(U)GlobalUsing.cs;$(U)Wine/**;@(UpstreamExclude)" />
    <Compile Include="$(U)ViewModel/Message/**/*.cs;$(U)ViewModel/IViewModel.cs;$(U)ViewModel/Pages/OneDragon/OneDragonBaseViewModel.cs;$(U)Core/Monitor/RelativeMouseInput.cs;$(U)ViewModel/Windows/AutoComboTreeViewModel.cs;$(U)ViewModel/Windows/ESkillClassifyViewModel.cs" />
    <Compile Include="Shims/**/*.cs;Mac/**/*.cs" />
    <!-- Embedded resources, with the logical names upstream's code looks up -->
    <EmbeddedResource Include="$(U)Resources/TargetItem/target-item-data.json" LogicalName="BetterGenshinImpact.Resources.TargetItem.target-item-data.json" />
    <EmbeddedResource Include="$(U)Resources/QuestVoice/*" LogicalName="BetterGenshinImpact.Resources.QuestVoice.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The macOS front end (assembly "BetterGI") drives upstream's internal task types directly. -->
    <InternalsVisibleTo Include="BetterGI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BetterGI.Mac.Platform/BetterGI.Mac.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="Anthropic" Version="12.53.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <PackageReference Include="CsTrees" Version="1.0.5" />
    <PackageReference Include="CsTrees.MEAI" Version="1.0.2" />
    <PackageReference Include="DeviceId" Version="6.9.0" />
    <PackageReference Include="HungarianAlgorithm" Version="2.3.5" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="LazyCache" Version="2.4.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OpenccNetLib" Version="1.7.0" />
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.4.5" />
    <PackageReference Include="NCalc" Version="6.2.0" />
    <PackageReference Include="Semver" Version="3.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="Vanara.PInvoke.CoreAudio" Version="4.1.3" />
    <PackageReference Include="Vanara.PInvoke.NtDll" Version="4.1.3" />
    <PackageReference Include="Vanara.PInvoke.SHCore" Version="4.1.3" />

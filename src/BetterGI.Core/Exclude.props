<Project>
  <!-- Upstream files left out of the macOS build because they are Windows-only by nature.
       Paths are relative to upstream/BetterGenshinImpact/. Keep each group commented with the reason. -->
  <PropertyGroup>
    <U>$(UpstreamRoot)BetterGenshinImpact/</U>
  </PropertyGroup>
  <ItemGroup>
    <!-- WebView2: cloud-game web runtime, script repo web UI -->
    <UpstreamExclude Include="$(U)Infrastructure/WebView/**;$(U)Core/Input/Backends/WebSdk/**;$(U)GameTask/Runtime/WebPage/**;$(U)Core/Script/WebView/**" />
    <!-- Win32 low-level hooks, raw input, DirectInput -->
    <UpstreamExclude Include="$(U)Core/Monitor/**;$(U)Core/Recorder/GlobalKeyMouseRecord.cs;$(U)Core/Script/Dependence/KeyMouseHook.cs" />
    <!-- WPF window helpers, DPI awareness, WPF log sinks -->
    <UpstreamExclude Include="$(U)Helpers/Ui/**;$(U)Helpers/DpiAwareness/**;$(U)Helpers/OverlayLogDocument.cs;$(U)Helpers/BoundedRichTextBoxSink.cs" />
    <!-- Windows services: credential manager, updater, toast notifications, child sessions, overlays -->
    <UpstreamExclude Include="$(U)Helpers/Win32/MirrorChyanHelper.cs;$(U)Helpers/Win32/CredentialManagerHelper.cs;$(U)Pulonia/Services/PuloniaWindowsCredentialVault.cs" />
    <UpstreamExclude Include="$(U)Service/Instance/InstanceVisualIdentity.cs;$(U)Service/ChildSession/**;$(U)Service/Guide/**;$(U)Service/OverlayMetricsService.cs;$(U)Service/PictureInPictureService.cs;$(U)Service/RecognitionTemplateEditorService.cs;$(U)Service/UpdateService.cs;$(U)Service/ApplicationHostService.cs;$(U)Service/Notifier/WindowsUwpNotifier.cs;$(U)Service/I18n/TExtension.cs" />
    <!-- Win32 window runtime and window functions (replaced by Mac/) -->
    <UpstreamExclude Include="$(U)GameTask/Runtime/Win32/**;$(U)GameTask/SystemControl.cs" />
    <!-- DirectML / DXGI adapter discovery -->
    <UpstreamExclude Include="$(U)Core/Recognition/ONNX/InferenceDeviceDiscovery.cs" />
    <!-- Builds WPF controls in code -->
    <UpstreamExclude Include="$(U)Model/SettingItem.cs;$(U)GameTask/AutoCombo/AutoComboTreeWindowService.cs" />
    <!-- WebView2 HTML overlays -->
    <UpstreamExclude Include="$(U)Service/CustomHtmlMaskService.cs;$(U)Core/Script/Dependence/HtmlMask.cs" />
    <!-- WPF / GDI bitmap conversion, pack:// resources -->
    <UpstreamExclude Include="$(U)Helpers/Extensions/BitmapExtension.cs;$(U)Helpers/Extensions/MatExtension.cs;$(U)Service/ImageSourceDecoder.cs;$(U)Helpers/ResourceHelper.cs;$(U)GameTask/SkillCd/SkillCdOverlayRenderer.cs" />
    <!-- Win32 specifics with a macOS replacement in Mac/ or none yet -->
    <UpstreamExclude Include="$(U)Helpers/DeviceIdHelper.cs;$(U)Helpers/DpiHelper.cs;$(U)GameTask/UseRedeemCode/RedeemCodeManager.cs;$(U)GameTask/AutoPathing/PathRecorder.cs" />
    <!-- Replaced by a patched copy in Mac/Generated (see scripts/extract-upstream-members.py) -->
    <UpstreamExclude Include="$(U)Core/Config/Global.cs;$(U)Service/Instance/InstanceContext.cs;$(U)Service/Instance/InstanceBootstrap.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BetterGI.Mac.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- upstream's Fischless projects get this implicit using from UseWindowsForms -->
    <Using Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.arm64" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="Vanara.PInvoke.User32" Version="4.1.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Upstream contracts compiled unchanged, so the macOS implementations plug into upstream's seams. -->
    <Compile Include="$(UpstreamRoot)Fischless.GameCapture/IGameCapture.cs" Link="Upstream/IGameCapture.cs" />
    <Compile Include="$(UpstreamRoot)Fischless.GameCapture/GameCaptureFrame.cs" Link="Upstream/GameCaptureFrame.cs" />
    <Compile Include="$(UpstreamRoot)Fischless.GameCapture/CaptureModes.cs;$(UpstreamRoot)Fischless.GameCapture/CaptureModeExtensions.cs" Link="Upstream/%(Filename)%(Extension)" />
    <Compile Include="$(UpstreamRoot)Fischless.WindowsInput/IInputSimulator.cs;$(UpstreamRoot)Fischless.WindowsInput/IKeyboardSimulator.cs;$(UpstreamRoot)Fischless.WindowsInput/IMouseSimulator.cs;$(UpstreamRoot)Fischless.WindowsInput/IInputDeviceStateAdaptor.cs;$(UpstreamRoot)Fischless.WindowsInput/MouseButton.cs" Link="Upstream/WindowsInput/%(Filename)%(Extension)" />
    <Compile Include="$(UpstreamRoot)Fischless.HotkeyCapture/Hotkey.cs;$(UpstreamRoot)Fischless.HotkeyCapture/KeyPressedEventArgs.cs" Link="Upstream/HotkeyCapture/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../native/BgiMacNative/build/libBgiMacNative.dylib" Link="libBgiMacNative.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
